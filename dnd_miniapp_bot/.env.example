# Токен от @BotFather
BOT_TOKEN=123456:PASTE_TOKEN_HERE

# Публичный HTTPS-адрес Mini App.
# Для локального теста через ngrok будет примерно: https://abc123.ngrok-free.app
BASE_URL=https://your-domain.example

# База данных SQLite
DB_PATH=data/dnd_miniapp.sqlite3

# Веб-сервер
HOST=0.0.0.0
PORT=8000

# Публичный сервер должен проверять подпись Telegram.
# Локальный лаунчер сам включает браузерный вход и не требует менять это значение.
DEV_MODE=0

# Telegram ID главного мастера для расширенного менеджмента искр.
# Если оставить 0, главным считается мастер самой первой созданной кампании.
MAIN_MASTER_TG_ID=0
